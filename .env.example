# Server-only Go API origin (scheme + host). Browser never sees this.
API_URL=
# Public origin of this web app (scheme + host). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://chat.ababilx.com
# Optional. Only for Search Console "HTML tag" method (meta content=...).
# HTML file method uses public/google*.html instead — leave this empty.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
